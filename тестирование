"""
Тестирование модуля последовательности Эйлера
"""

import unittest
import math
from euler_sequence import EulerSequence

class TestEulerSequence(unittest.TestCase):
    """Тесты для класса EulerSequence"""
    
    def setUp(self):
        """Настройка перед каждым тестом"""
        self.euler = EulerSequence()
        
    def test_euler_sequence_basic(self):
        """Тест базовых значений последовательности Эйлера"""
        # Известные значения последовательности Эйлера
        known_values = {
            1: 1,
            2: 3,
            3: 11,
            4: 50,
            5: 274,
            6: 1764,
            7: 13068,
            8: 109584,
            9: 1026576,
            10: 10628640
        }
        
        for n, expected in known_values.items():
            with self.subTest(n=n):
                result = self.euler.euler_sequence_optimized(n)
                self.assertEqual(result, expected, f"E({n}) должно быть {expected}, получено {result}")
                
    def test_euler_totient_function(self):
        """Тест функции Эйлера φ(n)"""
        # Известные значения функции Эйлера
        known_totients = {
            1: 1,
            2: 1,
            3: 2,
            4: 2,
            5: 4,
            6: 2,
            7: 6,
            8: 4,
            9: 6,
            10: 4,
            11: 10,
            12: 4,
            13: 12,
            14: 6,
            15: 8,
            16: 8,
            17: 16,
            18: 6,
            19: 18,
            20: 8
        }
        
        for n, expected in known_totients.items():
            with self.subTest(n=n):
                result = self.euler.euler_totient(n)
                self.assertEqual(result, expected, f"φ({n}) должно быть {expected}, получено {result}")
                
    def test_sequence_generation(self):
        """Тест генерации последовательности"""
        sequence = self.euler.generate_euler_sequence(10)
        
        # Проверка длины
        self.assertEqual(len(sequence), 10)
        
        # Проверка первых значений
        expected_first = [1, 3, 11, 50, 274, 1764, 13068, 109584, 1026576, 10628640]
        self.assertEqual(sequence, expected_first)
        
    def test_find_euler_number(self):
        """Тест поиска числа Эйлера"""
        # Поиск существующих чисел
        self.assertEqual(self.euler.find_euler_number(1), 1)
        self.assertEqual(self.euler.find_euler_number(11), 3)
        self.assertEqual(self.euler.find_euler_number(274), 5)
        self.assertEqual(self.euler.find_euler_number(1764), 6)
        
        # Поиск несуществующего числа
        self.assertIsNone(self.euler.find_euler_number(999, max_search=20))
        
    def test_find_euler_numbers_in_range(self):
        """Тест поиска чисел Эйлера в диапазоне"""
        # Поиск в диапазоне, где есть числа Эйлера
        results = self.euler.find_euler_numbers_in_range(10, 100)
        expected_in_range = [(3, 11), (4, 50), (5, 274)]
        
        # Фильтруем результаты, которые попадают в диапазон
        filtered_expected = [(n, val) for n, val in expected_in_range if 10 <= val <= 100]
        
        self.assertEqual(len(results), len(filtered_expected))
        for result in filtered_expected:
            self.assertIn(result, results)
            
    def test_perfect_numbers(self):
        """Тест поиска совершенных чисел"""
        perfect_numbers = self.euler.find_perfect_numbers(1000)
        
        # Известные совершенные числа
        known_perfect = [6, 28, 496]
        
        self.assertEqual(len(perfect_numbers), len(known_perfect))
        for num in known_perfect:
            self.assertIn(num, perfect_numbers)
            
    def test_euler_properties(self):
        """Тест анализа свойств чисел Эйлера"""
        properties = self.euler.analyze_euler_properties(5) # Проверка структуры
        required_keys = ['n', 'euler_number', 'is_prime', 'factors', 'divisors_count',


'sum_of_divisors', 'is_perfect', 'phi_of_euler', 'digits', 'digital_root']
        
        for key in required_keys:
            self.assertIn(key, properties)
            
        # Проверка значений
        self.assertEqual(properties['n'], 5)
        self.assertEqual(properties['euler_number'], 274)
        self.assertFalse(properties['is_prime'])  # 274 = 2 * 137
        self.assertEqual(properties['phi_of_euler'], 136)  # φ(274) = φ(2) * φ(137) = 1 * 136
        
    def test_get_divisors(self):
        """Тест получения делителей числа"""
        # Тест с простым числом
        divisors_prime = self.euler.get_divisors(13)
        self.assertEqual(divisors_prime, [1, 13])
        
        # Тест с составным числом
        divisors_composite = self.euler.get_divisors(12)
        expected = [1, 2, 3, 4, 6, 12]
        self.assertEqual(divisors_composite, expected)
        
        # Тест с единицей
        divisors_one = self.euler.get_divisors(1)
        self.assertEqual(divisors_one, [1])
        
    def test_digital_root(self):
        """Тест цифрового корня"""
        test_cases = [
            (0, 0),
            (1, 1),
            (9, 9),
            (10, 1),
            (11, 2),
            (19, 1),
            (274, 4),  # 2+7+4 = 13, 1+3 = 4
            (999, 9),  # 9+9+9 = 27, 2+7 = 9
        ]
        
        for num, expected in test_cases:
            with self.subTest(num=num):
                result = self.euler.digital_root(num)
                self.assertEqual(result, expected)
                
    def test_sequence_consistency(self):
        """Тест согласованности разных методов вычисления"""
        for n in range(1, 11):
            recursive = self.euler.euler_sequence_recursive(n)
            iterative = self.euler.euler_sequence_iterative(n)
            optimized = self.euler.euler_sequence_optimized(n)
            
            self.assertEqual(recursive, iterative, f"Несоответствие для n={n}")
            self.assertEqual(iterative, optimized, f"Несоответствие для n={n}")
            
    def test_growth_rate(self):
        """Тест темпа роста последовательности"""
        # Последовательность Эйлера должна расти быстрее факториала
        for n in range(3, 8):
            euler_n = self.euler.euler_sequence_optimized(n)
            factorial_n = math.factorial(n)
            
            # E(n) должно быть больше n! для n > 2
            self.assertGreater(euler_n, factorial_n, f"E({n}) должно быть больше {n}!")
            
    def test_cache_functionality(self):
        """Тест работы кэша"""
        # Очистка кэша
        self.euler.cache.clear()
        
        # Первое вычисление
        result1 = self.euler.euler_sequence_optimized(10)
        
        # Второе вычисление должно использовать кэш
        result2 = self.euler.euler_sequence_optimized(10)
        
        self.assertEqual(result1, result2)
        self.assertIn(10, self.euler.cache)
        
    def test_edge_cases(self):
        """Тест граничных случаев"""
        # Нулевые и отрицательные значения
        self.assertEqual(self.euler.euler_sequence_optimized(0), 0)
        self.assertEqual(self.euler.euler_sequence_optimized(-5), 0)
        
        # Единица
        self.assertEqual(self.euler.euler_sequence_optimized(1), 1)
        
        # Функция Эйлера для граничных случаев
        self.assertEqual(self.euler.euler_totient(0), 0)
        self.assertEqual(self.euler.euler_totient(1), 1)

def run_performance_tests():
    """Тесты производительности"""
    print("\n⚡ Тесты производительности")
    print("=" * 30)
    
    euler = EulerSequence()
    
    import time
    
    # Тест скорости вычисления
    test_values = [10, 15, 20]
    
    for n in test_values:
        start_time = time.time()
        result = euler.euler_sequence_optimized(n)
        end_time = time.time()
        
        print(f"E({n}) = {result:,}")
        print(f"Время вычисления: {(end_time - start_time) * 1000:.2f} мс")


# Тест генерации последовательности
    start_time = time.time()
    sequence = euler.generate_euler_sequence(15)
    end_time = time.time()
    
    print(f"\nГенерация последовательности до 15:")
    print(f"Время: {(end_time - start_time) * 1000:.2f} мс")
    print(f"Последние 5 значений: {sequence[-5:]}")

def run_correctness_tests():
    """Тесты корректности вычислений"""
    print("\n✅ Тесты корректности")
    print("=" * 30)
    
    euler = EulerSequence()
    
    # Проверка рекуррентной формулы
    print("Проверка рекуррентной формулы E(n) = n * E(n-1) + (n-1)!")
    for n in range(2, 8):
        left = euler.euler_sequence_optimized(n)
        right = n * euler.euler_sequence_optimized(n-1) + math.factorial(n-1)
        status = "✅" if left == right else "❌"
        print(f"{status} E({n}) = {left:,}, формула: {right:,}")
        
    # Проверка соотношения с гармоническими числами
    print("\nПроверка соотношения с гармоническими числами:")
    for n in range(2, 6):
        euler_num = euler.euler_sequence_optimized(n)
        factorial = math.factorial(n)
        harmonic = sum(1.0 / k for k in range(1, n + 1))
        expected = round(factorial * harmonic)
        
        status = "✅" if euler_num == expected else "❌"
        print(f"{status} E({n}) = {euler_num:,}, H({n}) * {n}! = {expected:,}")

def main():
    """Основная функция тестирования"""
    print("🧪 Тестирование модуля последовательности Эйлера")
    print("=" * 50)
    
    # Запуск unit тестов
    print("\n🔬 Запуск unit тестов...")
    unittest.main(argv=[''], exit=False, verbosity=2)
    
    # Дополнительные тесты
    run_performance_tests()
    run_correctness_tests()
    
    print("\n🎉 Все тесты завершены!")

if __name__ == "__main__":
    main()
        
